# Required — get a free key at https://console.groq.com
GROQ_API_KEY=

# Model (free-tier friendly). Prefer gpt-oss-120b for quality; switch to gpt-oss-20b if you hit TPM/RPD.
# llama-3.3-70b-versatile was retired by Groq on 2026-08-16.
GROQ_MODEL=openai/gpt-oss-120b

# App-side free-tier budgets (hard stop BEFORE calling Groq)
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_DAY=50
MAX_IN_FLIGHT=1
MAX_CODE_CHARS=6000
MAX_ESTIMATED_INPUT_TOKENS=4000
GROQ_TIMEOUT_MS=30000
